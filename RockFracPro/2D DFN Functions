function r=PowerLaw_rnd(alpha,xmin,n)
%分布的最小值xmin
% 幂律指数alpha 
% 生成的样本数量n 
%生成符合幂律分布的随机数
r = xmin * (1 - rand(n, 1)).^(-1/(alpha-1));
% 绘制直方图
Truncated_PowerLaw_rnd函数
% 分布的最小值xmin  % 幂律指数alpha   % 分布的最大值xmax
% 生成的样本数量n   % 生成符合截尾幂律分布的随机数
function r=Truncated_PowerLaw_rnd(alpha,xmin,xmax,n)
x = xmin + (xmax - xmin) .* rand(n, 1);
y = x.^(-alpha) .* exp(-x./xmax);
p =abs( y ./ trapz(x, y)); % 归一化
% 使用归一化后的分布生成随机数
x_rand = randsample(x, n, true, p);
r=x_rand;



