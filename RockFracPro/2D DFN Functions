function Eta=Cal_Connection_Eta(Frac_Information,Frac_pointdata,DFN,Scale_chang,Scale_kuan)
Total_Frac_density=sum(DFN(:,2));
Lt=sum(Frac_Information(:,7));
N_f=size(Frac_Information,1);
Lave=Lt/N_f;
E=Total_Frac_density*(Lave/2)^2;
all_point=Frac_pointdata;
for i=1:max(all_point(:,3))
    Fracture_num_forone(i,1)=i;
    Fracture_num_forone(i,2)=size(find(all_point(:,3)==i),1)-2;  
end
   N_node=sum(Fracture_num_forone(:,2));
A=Scale_chang*Scale_kuan;
den_seg=(N_f+2*N_node)/A;
Eta=(A*E*den_seg)^0.5;
 
 
Fisher_rnd函数
function r = Fisher_rnd(nu1, nu2, m, n)   %% nu1，nu2为自由度，m，n为行、列
% Syntax: r = fisher_rnd(nu1, nu2, m, n)
%    nu1, nu2 - the degrees of freedom for the distribution
%    m, n - the size of the output array
%    r - an array of random numbers with the specified size
% See also: fpdf, finv

if nargin < 4
    n = 1;
end
if nargin < 3
    m = 1;
End

% Generate standard normal random variables
z = randn(nu2, m*n);
% Calculate chi-squared random variables
x = sum(z.^2, 1);
% Calculate Fisher random variables
r = (nu1 * x) ./ (nu2 + nu1 * x);
% Reshape output array to the specified size
r = reshape(r, m, n);


