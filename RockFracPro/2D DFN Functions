Gen_Fracture函数
   function Fracture_Infor=Gen_Fracture(NumGroup_frac,DFN,Scale_chang,Scale_kuan)
  Frac_Infor=[];
  for Num=1:NumGroup_frac
    Frac_density=DFN(Num,2);
    Frac_strike_average=DFN(Num,3);
    Frac_strike_sdeviation=DFN(Num,4);
      Frac_length_alpha=DFN(Num,5);
      Frac_length_min=DFN(Num,6);
      Frac_length_max=DFN(Num,7);
          Frac_aperture_gama=DFN(Num,8);
          Frac_aperture_D=DFN(Num,9);
    Area=Scale_chang*Scale_kuan;
    Num_frac=Area*Frac_density;
    Point_c=unifrnd(-Scale_chang/2,Scale_kuan/2,Num_frac,2);   %生成中心点坐标
    Frac_strike=normrnd(Frac_strike_average, Frac_strike_sdeviation,Num_frac,1); 
    Frac_length=Truncated_PowerLaw_rnd(Frac_length_alpha, Frac_length_min, Frac_length_max, Num_frac);
    Frac_aperture=Frac_aperture_gama*(Frac_length.^Frac_aperture_D); %与长度相关
    x1=Point_c(:,1)+(Frac_length ./2).*cos(Frac_strike*pi/180);
    y1=Point_c(:,2)+(Frac_length ./2).*sin(Frac_strike*pi/180);
    x2=Point_c(:,1)+(Frac_length ./2).*cos((Frac_strike+180)*pi/180);
    y2=Point_c(:,2)+(Frac_length ./2).*sin((Frac_strike+180)*pi/180);
    for  i=1:Num_frac
        if  x1(i)>x2(i)
            w=x2(i);
            x2(i)=x1(i);
            q=y2(i);
            y2(i)=y1(i);
            x1(i)=w;
            y1(i)=q;
        end
      end    
    Frac_Infor1=[x1,y1,x2,y2,Frac_strike,Frac_aperture,Frac_length];
     if  isempty(Frac_Infor)
      Frac_Infor=Frac_Infor1;
    else
       Frac_Infor=[Frac_Infor;Frac_Infor1];
    end 
end
Fracture_Infor=Frac_Infor;


